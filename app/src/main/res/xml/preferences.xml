<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
	<EditTextPreference
		android:key="pref_currency"
		android:title="@string/pref_currency"
		android:summary="@string/pref_currency_summary"
		android:useSimpleSummaryProvider="true"
		android:defaultValue="$" />

	<EditTextPreference
		android:key="pref_stock_alert"
		android:title="@string/pref_stock_alert"
		android:useSimpleSummaryProvider="true"
		android:defaultValue="10" />

	<Preference
		android:key="pref_backup"
		android:title="@string/pref_backup"
		android:summary="@string/pref_backup_summary" />

	<Preference
		android:key="pref_restore"
		android:title="@string/pref_restore"
		android:summary="@string/pref_restore_summary" />

	<ListPreference
		android:key="pref_backup_location"
		android:title="@string/pref_backup_location"
		android:entries="@array/backup_location_entries"
		android:entryValues="@array/backup_location_values"
		android:defaultValue="local" />
</PreferenceScreen>